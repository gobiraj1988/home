# ============================================================
#  APEX Quant MCP — environment configuration
#  Copy this file to ".env" and fill in your values.
# ============================================================

# --- Filesystem RAG server ---
# Root folder Claude is allowed to read research docs & CSV data from.
APEX_DATA_DIR=J:\APEX_AGI_Forex_Trading_Bot

# Where the RAG index is persisted (defaults to <data dir>/.apex_index)
# APEX_INDEX_DIR=J:\APEX_AGI_Forex_Trading_Bot\.apex_index

# Comma-separated file extensions to ingest for RAG
APEX_RAG_EXTENSIONS=.md,.txt,.pdf,.docx,.csv

# --- MT5 live data server ---
# Leave login blank to attach to an already-running MT5 terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional explicit path to terminal64.exe (auto-detected if blank)
MT5_TERMINAL_PATH=

# --- Backtest sharing (Zapier connector) ---
# Create a Zap with a "Webhooks by Zapier -> Catch Hook" trigger that
# fans out to Slack (post message) and Google Drive (upload file).
# Paste the catch-hook URL here.
ZAPIER_WEBHOOK_URL=
# Optional: a second hook dedicated to file uploads (Drive). Falls back
# to ZAPIER_WEBHOOK_URL if left blank.
ZAPIER_FILE_WEBHOOK_URL=

# --- Logging ---
APEX_LOG_LEVEL=INFO
