{
  "//": "APEX Quant MCP — paste these entries into your Claude Desktop config.",
  "//_windows_path": "%APPDATA%\\Claude\\claude_desktop_config.json",
  "//_mac_path": "~/Library/Application Support/Claude/claude_desktop_config.json",
  "//_note": "Replace C:\\path\\to\\apex-quant-mcp with where you cloned this repo. Using the venv python guarantees the deps are found.",
  "mcpServers": {
    "apex-rag": {
      "command": "C:\\path\\to\\apex-quant-mcp\\.venv\\Scripts\\python.exe",
      "args": ["-m", "apex_mcp.rag_server"],
      "cwd": "C:\\path\\to\\apex-quant-mcp",
      "env": {
        "APEX_DATA_DIR": "J:\\APEX_AGI_Forex_Trading_Bot"
      }
    },
    "apex-mt5": {
      "command": "C:\\path\\to\\apex-quant-mcp\\.venv\\Scripts\\python.exe",
      "args": ["-m", "apex_mcp.mt5_server"],
      "cwd": "C:\\path\\to\\apex-quant-mcp",
      "env": {
        "MT5_LOGIN": "",
        "MT5_PASSWORD": "",
        "MT5_SERVER": ""
      }
    },
    "apex-share": {
      "command": "C:\\path\\to\\apex-quant-mcp\\.venv\\Scripts\\python.exe",
      "args": ["-m", "apex_mcp.share_server"],
      "cwd": "C:\\path\\to\\apex-quant-mcp",
      "env": {
        "ZAPIER_WEBHOOK_URL": ""
      }
    }
  }
}
